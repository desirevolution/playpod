  {
    "id": "playpod-command-v1",
    "type": "function",
    "z": "playpod-v1-example",
    "name": "PlayPod-Adresse setzen",
    "func": "// Diese eine Adresse anpassen (aus Node-RED erreichbar).\nconst base = \"http://PLAYPOD-HOST:9393\";\nconst commands = {\n  toggle: [\"POST\", \"playback/toggle\", {timer:\"default\",when_queue_empty:\"default\"}],\n  play: [\"POST\", \"playback/play\", {timer:\"default\",when_queue_empty:\"default\"}],\n  pause: [\"POST\", \"playback/pause\", {}],\n  next: [\"POST\", \"playback/next\", {timer:\"default\",when_queue_empty:\"default\"}],\n  forward: [\"POST\", \"seek\", {offset_seconds:30}],\n  rewind: [\"POST\", \"seek\", {offset_seconds:-30}],\n  volume_up: [\"POST\", \"volume/adjust\", {delta:5}],\n  volume_down: [\"POST\", \"volume/adjust\", {delta:-5}],\n  mode: [\"POST\", \"mode/toggle\", {}],\n  extend: [\"POST\", \"timer/extend\", {minutes:5}],\n  refresh: [\"POST\", \"feeds/refresh\", {}],\n  state: [\"GET\", \"state\", null]\n};\nconst command = Object.hasOwn(commands, msg.topic) ? commands[msg.topic] : null;\nif (!command) { node.error(\"Unbekannter PlayPod-Befehl: \" + msg.topic, msg); return null; }\nmsg.method = command[0];\nmsg.url = base.replace(/\\/$/, \"\") + \"/api/v1/\" + command[1];\nmsg.headers = {\"Content-Type\":\"application/json\"};\nif (command[2] === null) delete msg.payload;\nelse msg.payload = command[2];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 510,
    "y": 240,
    "wires": [
      [
        "playpod-request-v1"
      ]
    ]
  },
