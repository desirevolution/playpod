# Optional published image, e.g. ghcr.io/OWNER/REPOSITORY:1.0.0
PLAYPOD_IMAGE=playpod:local

# Copy to .env and use the LAN address or a Docker-network hostname reachable from PlayPod.
# Empty: browser playback only. Set e.g. 192.168.178.100 to enable MPD as default.
MPD_HOST=
MPD_PORT=6600
MPD_PASSWORD=

# Optional integrations. Empty disables the integration.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=podplayer/status
# Optional endpoint: returns {"url":"http://.../api/tts_proxy/...wav"} for MPD playback.
TTS_AUDIO_URL=
TTS_PLAYBACK_TIMEOUT_SECONDS=120
# Wait for the title request before starting playback; errors/timeouts still allow playback.
TTS_TIMEOUT_SECONDS=10
RSS_INTERVAL_SECONDS=3600

# Access requests are quiet by default; application/error logs remain enabled.
ACCESS_LOG=false

# Optional local media. See README and compose.media.yml.
MEDIA_BASE_URL=
MEDIA_ROOTS=
MEDIA_STABLE_SECONDS=5
# MEDIA_DIRECTORY=/srv/podcasts

# Feed downloads are stored in the existing PlayPod data volume.
# Set MEDIA_BASE_URL above to the PlayPod address reachable from MPD, e.g.
# MEDIA_BASE_URL=http://192.168.178.100:9393
DOWNLOAD_MAX_BYTES=2147483648

# Optional page-link downloads in the same container (yt-dlp, FFmpeg, QuickJS-NG).
YTDLP_JS_RUNTIME=quickjs
YTDLP_ENABLED=true
YTDLP_TIMEOUT=3600
